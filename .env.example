# ─────────────────────────────────────────────────────────────
# Cadence — environment template
# Copy to `.env` and fill. NEVER commit `.env`.
# Shannon testnet (chain 50312) is the default until explicitly told otherwise.
# ─────────────────────────────────────────────────────────────

# Network selector: "testnet" (50312) | "mainnet" (5031)
CADENCE_NETWORK=testnet

# ── Chain endpoints (overridable; defaults live in packages/shared) ──
# Testnet
TESTNET_RPC_URL=https://dream-rpc.somnia.network
TESTNET_REST_URL=https://stg.api.dreamdex.io/v0
TESTNET_WS_URL=wss://stg.api.dreamdex.io/v0/ws/public
# Mainnet
MAINNET_RPC_URL=https://api.infra.mainnet.somnia.network
MAINNET_REST_URL=https://api.dreamdex.io/v0
MAINNET_WS_URL=wss://api.dreamdex.io/v0/ws/public

# ── Keys (testnet only in this template; use a keystore for mainnet) ──
# Deployer / operator trading key. 0x-prefixed.
DEPLOYER_PRIVATE_KEY=
# The AI copilot's attestation signer (separate key from trading).
COPILOT_SIGNER_KEY=

# ── Deployed Cadence contract addresses (filled by scripts/deploy.ts) ──
REACTIVITY_SUBSCRIBER_ADDRESS=
AGENT_VAULT_FACTORY_ADDRESS=
RISK_ENGINE_ADDRESS=
STRATEGY_NFT_ADDRESS=
COPILOT_ATTESTOR_ADDRESS=

# ── Venue: starting point only. Cadence reads the live venue on boot. ──
# Leave blank to force live resolution; set only to override.
VENUE_ID_OVERRIDE=

# ── Supabase (indexed/cached telemetry reads ONLY — never source of truth) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI copilot model backend (kept OFF the reactive critical path, §5) ──
COPILOT_LLM_ENDPOINT=
COPILOT_LLM_API_KEY=

# ── Public URLs surfaced in the frontend ──
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_EXPLORER_BASE=https://shannon-explorer.somnia.network
NEXT_PUBLIC_ORACLE_EXPLORER_BASE=https://prd.oracle.somnia.host/questions
